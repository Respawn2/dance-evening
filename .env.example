# Порт, на котором сервис принимает запросы
PORT=8080

# Уровень журнала: debug | info | warning | error
LOG_LEVEL=info

# Среда запуска: development | test | production
ENVIRONMENT=development

# Версия: подставляется при сборке, локально оставьте как есть
APP_VERSION=0.0.0-dev

# Адрес базы данных. ОБЯЗАТЕЛЬНАЯ переменная, значения по умолчанию нет.
# Локально для запуска через Compose:
DATABASE_URL=postgresql://evenings:evenings@localhost:5432/evenings
