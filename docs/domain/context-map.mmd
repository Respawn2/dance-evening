%% Карта ограниченных контекстов «Вечеров» — ЛР 2Б.
%% Обоснование границ и связей — docs/domain/event-storming.md
flowchart LR
    subgraph own["Система «Вечера»"]
        core["Вечера и записи<br/><i>основной контекст</i><br/>вечера, записи, роли в паре,<br/>баланс, цена, состав, вход"]
        reviews["Отзывы и репутация<br/><i>поддерживающий</i><br/>отзывы, оценки, витрина"]
        accounts["Учёт участников<br/><i>поддерживающий</i><br/>пользователи, роли, ники"]
        notify["Уведомления<br/><i>общего назначения</i><br/>доставка фактов, не модель"]
    end

    venues["Обслуживание заведений<br/><i>вне охвата семестра</i>"]
    mail["Почтовый сервер<br/><i>чужая система</i>"]

    accounts -->|"поставщик — потребитель<br/>идентификатор и роль пользователя"| core
    core -->|"поставщик — потребитель<br/>список отметившихся"| reviews
    core -->|"уровень предотвращения искажений<br/>факт события, не текст письма"| notify
    notify -->|"подчинённый<br/>протокол SMTP принимаем как есть"| mail
    core -.->|"раздельные пути<br/>интеграция дороже дублирования"| venues

    classDef core fill:#FBF0EC,stroke:#E2603A,color:#16202E
    classDef sup fill:#ECF6F4,stroke:#3E9E8F,color:#16202E
    classDef ext fill:#F1F3F6,stroke:#5B6472,color:#16202E
    class core core
    class reviews,accounts,notify sup
    class venues,mail ext
