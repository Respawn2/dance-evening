# Единые настройки редакторов: IDEA, VS Code и другие читают этот файл.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
# В Markdown пробелы в конце строки — осмысленный перенос, не обрезаем.
trim_trailing_whitespace = false

[*.{yml, yaml}]
indent_size = 2

[*.py]
indent_size = 4
